# Local: npm run dev genera .env.local con una clave aleatoria.
# Vercel: configurar estas variables en Settings > Environment Variables.
ADMIN_KEY=CAMBIAR-POR-UNA-CLAVE-PERSONAL
# Supabase > Connect > Transaction pooler. Reemplazá la contraseña (URL-encoded).
DATABASE_URL=postgresql://postgres.TU-PROJECT-REF:TU-PASSWORD@TU-POOLER.supabase.com:6543/postgres
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
# Supabase > Settings > API Keys > Secret keys. Solo servidor, nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
# Opcional: conexión directa o Session pooler para npm run db:migrate.
# MIGRATION_DATABASE_URL=postgresql://...
